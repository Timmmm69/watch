# Local development only. Copy to .env and replace values for your environment.
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://watch:watch_dev@127.0.0.1:5432/watch?schema=public
API_HOST=127.0.0.1
API_PORT=3001
TELEGRAM_BOT_TOKEN=replace-with-dev-bot-token
TELEGRAM_BOT_USERNAME=replace_with_bot_username
# Generate separately from CSRF_SECRET, with 32+ Telegram-allowed characters.
TELEGRAM_WEBHOOK_SECRET=replace-with-random-telegram-webhook-secret
SUPPORT_CONTACT=@support_username
# Generate a unique value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CSRF_SECRET=replace-with-random-base64url-secret
# Comma-separated unique Telegram user IDs; empty disables Admin access.
ADMIN_TELEGRAM_IDS=
# Single immutable MVP platform currency (ISO 4217). Persisted once by
# `pnpm --filter @watch/api catalog:bootstrap`; after that it can never change.
PLATFORM_CURRENCY=BYN
# DELIVERED snapshots this hold once (provisional U05 default).
ORDER_HOLD_DAYS=14
# Optional U03 operational SLA: seconds in the current pre-delivery state.
# ORDER_OVERDUE_SECONDS=86400
# U01 resolved: Google Sheets is the authoritative physical-inventory source.
# The adapter is implemented in T18. Keep credentials out of git.
# INVENTORY_PROVIDER=google_sheets
# GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-spreadsheet-id
# GOOGLE_SHEETS_WORKSHEET_NAME=inventory
# Base64 of the complete Google service-account JSON; base64 is encoding, not encryption.
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON_B64=replace-with-base64-service-account-json
# Share the Sheet with client_email as Viewer and enable the Google Sheets API.
# First row requires external_key and stock_quantity; extra columns are ignored.
# Resolved technical inventory cadence/freshness.
# INVENTORY_SYNC_INTERVAL_SECONDS=120
# INVENTORY_MAX_AGE_SECONDS=600
# S3-compatible private object storage for Product IMAGE/VIDEO assets.
# Cloudflare R2 is the selected production target; local development may use another S3-compatible endpoint.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=watch-media
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret-key
# Current legal documents. IDs/versions come from `pnpm --filter @watch/api legal:publish ...`.
LEGAL_PARTNER_TERMS_ID=replace-with-partner-terms-uuid
LEGAL_PARTNER_TERMS_VERSION=replace-with-partner-terms-version
# LEGAL_SALES_TERMS_ID=replace-with-sales-terms-uuid
# LEGAL_SALES_TERMS_VERSION=replace-with-sales-terms-version
# LEGAL_PRIVACY_ID=replace-with-privacy-uuid
# LEGAL_PRIVACY_VERSION=replace-with-privacy-version
POSTGRES_USER=watch
POSTGRES_PASSWORD=watch_dev
POSTGRES_DB=watch
POSTGRES_PORT=5432
