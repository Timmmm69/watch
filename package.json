{
  "name": "watch",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter @watch/config --filter @watch/contracts --filter @watch/db --filter @watch/api --filter @watch/web dev",
    "dev:bot": "pnpm --filter @watch/api worker:dev",
    "build:packages": "pnpm --filter @watch/config --filter @watch/contracts --filter @watch/db build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:topology": "node --test ops/docker/security.test.mjs",
    "test:db-security": "node --test ops/docker/database-security.test.mjs",
    "test:ops": "node --test ops/scripts/operations.test.mjs",
    "test:restore": "node --test ops/scripts/restore.integration.test.mjs",
    "deploy:production": "node ops/scripts/deploy.mjs",
    "smoke:production": "node ops/scripts/smoke.mjs",
    "backup:production": "node ops/scripts/backup.mjs backup",
    "test:e2e": "pnpm --filter @watch/web test:e2e",
    "test:financial": "pnpm build:packages && pnpm --filter @watch/api test:financial",
    "db:generate": "pnpm --filter @watch/db db:generate",
    "db:migrate": "pnpm --filter @watch/db db:migrate"
  }
}
