generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  telegramUserId   BigInt    @unique @map("telegram_user_id")
  firstName        String    @map("first_name") @db.VarChar(128)
  lastName         String?   @map("last_name") @db.VarChar(128)
  username         String?   @db.VarChar(64)
  languageCode     String?   @map("language_code") @db.VarChar(16)
  isAdmin          Boolean   @default(false) @map("is_admin")
  isBlocked        Boolean   @default(false) @map("is_blocked")
  botCanMessage    Boolean   @default(false) @map("bot_can_message")
  botStartedAt     DateTime? @map("bot_started_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  sessions         Session[]
  partner          Partner?
  auditLogs        AuditLog[]
  referralLinksDisabled ReferralLink[] @relation("ReferralLinkDisabledBy")
  attributionTouches AttributionTouch[]
  orders Order[]
  orderFulfillmentRedactions OrderFulfillmentDetail[] @relation("OrderFulfillmentRedactedBy")
  reconciledReservations InventoryReservation[] @relation("InventoryReservationReconciledBy")
  cart             Cart?
  requestedPayouts Payout[] @relation("PayoutRequestedBy")
  processedPayouts Payout[] @relation("PayoutProcessedBy")
  createdReturns Return[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

enum TelegramUpdateStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model TelegramUpdate {
  updateId            BigInt               @id @map("update_id")
  payload             Json                 @db.JsonB
  status              TelegramUpdateStatus @default(PENDING)
  attempts            Int                  @default(0)
  nextAttemptAt       DateTime             @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  processingStartedAt DateTime?            @map("processing_started_at") @db.Timestamptz(6)
  leaseExpiresAt      DateTime?            @map("lease_expires_at") @db.Timestamptz(6)
  receivedAt          DateTime             @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt         DateTime?            @map("processed_at") @db.Timestamptz(6)
  lastError           String?              @map("last_error")

  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@index([receivedAt])
  @@map("telegram_updates")
}

enum LegalDocumentType {
  PARTNER_TERMS
  SALES_TERMS
  PRIVACY
}

model LegalDocument {
  id                   String            @id @default(uuid()) @db.Uuid
  type                 LegalDocumentType
  version              String            @db.VarChar(64)
  sha256               String            @db.Char(64)
  contentMarkdown      String            @map("content_markdown")
  requiresReacceptance Boolean           @default(false) @map("requires_reacceptance")
  effectiveAt          DateTime          @map("effective_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptances      PartnerTermsAcceptance[]
  salesTermsOrders Order[]         @relation("OrderSalesTerms")
  privacyOrders    Order[]         @relation("OrderPrivacy")

  @@unique([type, version])
  @@unique([type, sha256])
  @@map("legal_documents")
}

enum PartnerStatus {
  ACTIVE
  BLOCKED
}

model Partner {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @unique @map("user_id") @db.Uuid
  status      PartnerStatus @default(ACTIVE)
  blockReason String?       @map("block_reason")
  blockedAt   DateTime?     @map("blocked_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  acceptances PartnerTermsAcceptance[]
  referralLinks ReferralLink[]
  attributionTouches AttributionTouch[]
  attributedOrders Order[]
  commissions Commission[]
  ledgerEntries LedgerEntry[]
  payouts Payout[]

  @@index([status])
  @@map("partners")
}

model PartnerTermsAcceptance {
  partnerId       String        @map("partner_id") @db.Uuid
  legalDocumentId String        @map("legal_document_id") @db.Uuid
  acceptedAt      DateTime      @default(now()) @map("accepted_at") @db.Timestamptz(6)
  partner         Partner       @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  legalDocument   LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)

  @@id([partnerId, legalDocumentId])
  @@map("partner_terms_acceptances")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum VariantStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssetType {
  IMAGE
  VIDEO
  TEXT
}

enum AssetPurpose {
  STOREFRONT
  PARTNER_CONTENT
}

enum AssetStatus {
  ACTIVE
  ARCHIVED
}

enum InventorySourceStatus {
  UNINITIALIZED
  OK
  MISSING
  INVALID
}

enum InventorySyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model PlatformSetting {
  singletonId      Int      @id @default(1) @map("singleton_id") @db.SmallInt
  platformCurrency String   @unique @map("platform_currency") @db.VarChar(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

model Supplier {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @db.VarChar(200)
  status    SupplierStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  products  Product[]
  orders    Order[]

  @@map("suppliers")
}

model Category {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @db.VarChar(120)
  slug      String         @unique @db.VarChar(140)
  sortOrder Int            @default(0) @map("sort_order")
  status    CategoryStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  products  ProductCategory[]

  @@index([status, sortOrder])
  @@map("categories")
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  supplierId     String          @map("supplier_id") @db.Uuid
  title          String          @db.VarChar(200)
  slug           String          @unique @db.VarChar(220)
  description    String          @default("")
  brand          String?         @db.VarChar(120)
  specifications Json            @default("{}") @db.JsonB
  status         ProductStatus   @default(DRAFT)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  variants       ProductVariant[]
  categories     ProductCategory[]
  assets         ProductAsset[]
  referralLinks  ReferralLink[]

  @@index([supplierId, status])
  @@index([status, brand])
  @@map("products")
}

model ProductVariant {
  id                           String          @id @default(uuid()) @db.Uuid
  productId                    String          @map("product_id") @db.Uuid
  sku                          String          @unique @db.VarChar(100)
  attributes                   Json            @default("{}") @db.JsonB
  priceMinor                   Int             @map("price_minor")
  currency                     String          @db.VarChar(3)
  partnerCommissionUnitMinor   Int             @map("partner_commission_unit_minor")
  supplierSettlementUnitMinor  Int?            @map("supplier_settlement_unit_minor")
  inventoryExternalKey         String          @unique @map("inventory_external_key") @db.VarChar(200)
  status                       VariantStatus   @default(DRAFT)
  createdAt                    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  product                      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryItem                InventoryItem?
  assets                       ProductAsset[]
  cartItems                    CartItem[]
  orderItems                   OrderItem[]
  reservations                 InventoryReservation[]

  @@unique([id, productId])
  @@index([productId, status])
  @@map("product_variants")
}

model Cart {
  id          String     @id @default(uuid()) @db.Uuid
  buyerUserId String     @unique @map("buyer_user_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  buyer       User       @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  items       CartItem[]

  @@map("carts")
}

model CartItem {
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model ProductCategory {
  productId String   @map("product_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
  @@map("product_categories")
}

model ProductAsset {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @map("product_id") @db.Uuid
  variantId   String?      @map("variant_id") @db.Uuid
  type        AssetType
  purpose     AssetPurpose
  storageKey  String?      @map("storage_key") @db.VarChar(500)
  textContent String?      @map("text_content")
  mimeType    String?      @map("mime_type") @db.VarChar(100)
  sizeBytes   Int?         @map("size_bytes")
  sortOrder   Int          @default(0) @map("sort_order")
  status      AssetStatus  @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Restrict)

  @@index([productId, purpose, status, sortOrder])
  @@map("product_assets")
}

model InventoryItem {
  variantId                String                @id @map("variant_id") @db.Uuid
  sourceQuantity           Int?                  @map("source_quantity")
  safetyBuffer             Int                   @default(0) @map("safety_buffer")
  sourceStatus             InventorySourceStatus @default(UNINITIALIZED) @map("source_status")
  sourceVersion            String?               @map("source_version") @db.VarChar(200)
  lastAttemptAt            DateTime?             @map("last_attempt_at") @db.Timestamptz(6)
  lastSuccessfulSyncAt     DateTime?             @map("last_successful_sync_at") @db.Timestamptz(6)
  lastSuccessfulSyncRunId  String?               @map("last_successful_sync_run_id") @db.Uuid
  updatedAt                DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  variant                  ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  lastSuccessfulSyncRun    InventorySyncRun?     @relation(fields: [lastSuccessfulSyncRunId], references: [id], onDelete: Restrict)

  @@map("inventory_items")
}

model InventorySyncRun {
  id             String                @id @default(uuid()) @db.Uuid
  providerKey    String                @map("provider_key") @db.VarChar(64)
  status         InventorySyncRunStatus
  startedAt      DateTime              @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?             @map("finished_at") @db.Timestamptz(6)
  itemsProcessed Int                   @default(0) @map("items_processed")
  itemsFailed    Int                   @default(0) @map("items_failed")
  detailsJson    Json?                 @map("details_json") @db.JsonB
  errorSummary   String?               @map("error_summary")
  inventoryItems InventoryItem[]
  reconciliationReservations InventoryReservation[]

  @@index([startedAt])
  @@map("inventory_sync_runs")
}

enum EventProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Event {
  id                  String                @id @default(uuid()) @db.Uuid
  type                String
  aggregateType       String                @map("aggregate_type")
  aggregateId         String                @map("aggregate_id") @db.Uuid
  dedupeKey           String                @unique @map("dedupe_key")
  payload             Json                  @db.JsonB
  status              EventProcessingStatus @default(PENDING)
  attempts            Int                   @default(0)
  nextAttemptAt       DateTime              @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  processingStartedAt DateTime?             @map("processing_started_at") @db.Timestamptz(6)
  leaseExpiresAt      DateTime?             @map("lease_expires_at") @db.Timestamptz(6)
  processedAt         DateTime?             @map("processed_at") @db.Timestamptz(6)
  lastError           String?               @map("last_error")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@map("events")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  requestId   String?  @map("request_id")
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum ReferralLinkStatus {
  ACTIVE
  DISABLED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  FULFILLING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  DELIVERY_FAILED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum CommissionState {
  PENDING
  HOLD
  EARNED
  VOID
}

enum LedgerBucket {
  PENDING
  AVAILABLE
  PAYOUT_LOCKED
}

enum LedgerEntryType {
  COMMISSION_CREATE
  COMMISSION_RELEASE
  COMMISSION_REVERSAL
  PAYOUT_LOCK
  PAYOUT_PAID
  PAYOUT_REJECT
}

enum PayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

enum ReturnStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum ReservationReconciliationMethod {
  SOURCE_PROOF
  MANUAL
}

model ReferralLink {
  id                    String             @id @default(uuid()) @db.Uuid
  token                 String             @unique @db.VarChar(64)
  partnerId             String             @map("partner_id") @db.Uuid
  productId             String?            @map("product_id") @db.Uuid
  status                ReferralLinkStatus @default(ACTIVE)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  disabledAt            DateTime?          @map("disabled_at") @db.Timestamptz(6)
  disabledByAdminUserId String?            @map("disabled_by_admin_user_id") @db.Uuid
  disableReason         String?            @map("disable_reason")
  partner               Partner            @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  product               Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  disabledByAdmin       User?              @relation("ReferralLinkDisabledBy", fields: [disabledByAdminUserId], references: [id], onDelete: Restrict)
  touches               AttributionTouch[]

  @@unique([id, partnerId])
  @@map("referral_links")
}

model AttributionTouch {
  id                String       @id @default(uuid()) @db.Uuid
  buyerUserId       String       @map("buyer_user_id") @db.Uuid
  partnerId         String       @map("partner_id") @db.Uuid
  referralLinkId    String       @map("referral_link_id") @db.Uuid
  sourceFingerprint String       @unique @map("source_fingerprint") @db.Char(64)
  occurredAt        DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(6)
  buyer             User         @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  partner           Partner      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  referralLink      ReferralLink @relation(fields: [referralLinkId, partnerId], references: [id, partnerId], onDelete: Restrict)

  @@unique([id, partnerId])
  @@index([buyerUserId, occurredAt])
  @@index([partnerId, occurredAt])
  @@index([expiresAt])
  @@map("attribution_touches")
}

model Order {
  id                        String           @id @default(uuid()) @db.Uuid
  publicNumber              String           @unique @map("public_number") @db.VarChar(32)
  buyerUserId               String           @map("buyer_user_id") @db.Uuid
  supplierId                String           @map("supplier_id") @db.Uuid
  attributionTouchId        String?          @map("attribution_touch_id") @db.Uuid
  partnerIdSnapshot         String?          @map("partner_id_snapshot") @db.Uuid
  commissionEligibleSnapshot Boolean          @default(false) @map("commission_eligible_snapshot")
  status                    OrderStatus      @default(PLACED)
  currency                  String           @db.VarChar(3)
  subtotalMinor             Int              @map("subtotal_minor")
  totalMinor                Int              @map("total_minor")
  salesTermsDocumentId      String           @map("sales_terms_document_id") @db.Uuid
  privacyDocumentId         String           @map("privacy_document_id") @db.Uuid
  salesTermsAcceptedAt      DateTime         @map("sales_terms_accepted_at") @db.Timestamptz(6)
  privacyAcknowledgedAt     DateTime         @map("privacy_acknowledged_at") @db.Timestamptz(6)
  idempotencyKey            String           @map("idempotency_key") @db.VarChar(100)
  requestFingerprint        String           @map("request_fingerprint") @db.Char(64)
  completionEligibleAt      DateTime?        @map("completion_eligible_at") @db.Timestamptz(6)
  confirmedAt               DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  fulfillingAt              DateTime?        @map("fulfilling_at") @db.Timestamptz(6)
  shippedAt                 DateTime?        @map("shipped_at") @db.Timestamptz(6)
  deliveredAt               DateTime?        @map("delivered_at") @db.Timestamptz(6)
  completedAt               DateTime?        @map("completed_at") @db.Timestamptz(6)
  cancelledAt               DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  deliveryFailedAt          DateTime?        @map("delivery_failed_at") @db.Timestamptz(6)
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  buyer                     User             @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  supplier                  Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  partnerSnapshot           Partner?         @relation(fields: [partnerIdSnapshot], references: [id], onDelete: Restrict)
  salesTermsDocument        LegalDocument    @relation("OrderSalesTerms", fields: [salesTermsDocumentId], references: [id], onDelete: Restrict)
  privacyDocument           LegalDocument    @relation("OrderPrivacy", fields: [privacyDocumentId], references: [id], onDelete: Restrict)
  fulfillmentDetail         OrderFulfillmentDetail?
  items                     OrderItem[]
  commissions               Commission[]
  returns                   Return[]

  @@unique([buyerUserId, idempotencyKey])
  @@unique([id, partnerIdSnapshot])
  @@index([buyerUserId, createdAt])
  @@index([partnerIdSnapshot, createdAt])
  @@index([status, createdAt])
  @@index([attributionTouchId, createdAt])
  @@map("orders")
}

model OrderFulfillmentDetail {
  orderId                String    @id @map("order_id") @db.Uuid
  recipientName          String?   @map("recipient_name") @db.VarChar(100)
  phone                  String?   @db.VarChar(32)
  address                String?
  comment                String?   @db.VarChar(500)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  redactedAt             DateTime? @map("redacted_at") @db.Timestamptz(6)
  redactedByAdminUserId  String?   @map("redacted_by_admin_user_id") @db.Uuid
  order                  Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  redactedByAdmin        User?     @relation("OrderFulfillmentRedactedBy", fields: [redactedByAdminUserId], references: [id], onDelete: Restrict)

  @@map("order_fulfillment_details")
}

model OrderItem {
  id                                 String                @id @default(uuid()) @db.Uuid
  orderId                            String                @map("order_id") @db.Uuid
  variantId                          String                @map("variant_id") @db.Uuid
  skuSnapshot                        String                @map("sku_snapshot") @db.VarChar(100)
  titleSnapshot                      String                @map("title_snapshot") @db.VarChar(200)
  attributesSnapshot                 Json                  @default("{}") @map("attributes_snapshot") @db.JsonB
  quantity                           Int
  unitPriceMinor                     Int                   @map("unit_price_minor")
  partnerCommissionUnitSnapshotMinor Int                   @map("partner_commission_unit_snapshot_minor")
  supplierSettlementUnitSnapshotMinor Int?                 @map("supplier_settlement_unit_snapshot_minor")
  lineTotalMinor                     Int                   @map("line_total_minor")
  order                              Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant                            ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reservations                       InventoryReservation[]
  commissions                        Commission[]
  returnItems                        ReturnItem[]

  @@unique([orderId, variantId])
  @@unique([id, orderId])
  @@map("order_items")
}

model InventoryReservation {
  id                                 String                              @id @default(uuid()) @db.Uuid
  orderId                            String                              @map("order_id") @db.Uuid
  variantId                          String                              @map("variant_id") @db.Uuid
  quantity                           Int
  status                             ReservationStatus                   @default(ACTIVE)
  reconciliationMethod               ReservationReconciliationMethod?    @map("reconciliation_method")
  reconciliationReference            String?                             @map("reconciliation_reference") @db.VarChar(500)
  reconciliationSourceVersion        String?                             @map("reconciliation_source_version") @db.VarChar(200)
  reconciliationInventorySyncRunId   String?                             @map("reconciliation_inventory_sync_run_id") @db.Uuid
  reconciledByAdminUserId            String?                             @map("reconciled_by_admin_user_id") @db.Uuid
  reconciledAt                       DateTime?                           @map("reconciled_at") @db.Timestamptz(6)
  createdAt                          DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt                         DateTime?                           @map("released_at") @db.Timestamptz(6)
  consumedAt                         DateTime?                           @map("consumed_at") @db.Timestamptz(6)
  orderItem                          OrderItem                           @relation(fields: [orderId, variantId], references: [orderId, variantId], onDelete: Restrict)
  variant                            ProductVariant                      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reconciliationInventorySyncRun     InventorySyncRun?                   @relation(fields: [reconciliationInventorySyncRunId], references: [id], onDelete: Restrict)
  reconciledByAdmin                  User?                               @relation("InventoryReservationReconciledBy", fields: [reconciledByAdminUserId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([variantId, status])
  @@index([status, orderId])
  @@map("inventory_reservations")
}

// CHECKs, snapshot/append-only triggers and partial indexes live in the SQL migration.
model Commission {
  id                  String          @id @default(uuid()) @db.Uuid
  partnerId           String          @map("partner_id") @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  orderItemId         String          @unique @map("order_item_id") @db.Uuid
  quantity            Int
  unitAmountMinor     Int             @map("unit_amount_minor")
  grossAmountMinor    Int             @map("gross_amount_minor")
  reversedAmountMinor Int             @default(0) @map("reversed_amount_minor")
  state               CommissionState @default(PENDING)
  eligibleAt          DateTime?       @map("eligible_at") @db.Timestamptz(6)
  availableAt         DateTime?       @map("available_at") @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  partner             Partner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  order               Order           @relation(fields: [orderId, partnerId], references: [id, partnerIdSnapshot], onDelete: Restrict)
  orderItem           OrderItem       @relation(fields: [orderItemId, orderId], references: [id, orderId], onDelete: Restrict)
  ledgerEntries       LedgerEntry[]

  @@unique([id, partnerId])
  @@index([partnerId, state, createdAt])
  @@index([orderId])
  @@map("commissions")
}

// Foundation for LedgerEntry's composite FK; payout operations/allocations are S14.
model Payout {
  id                     String       @id @default(uuid()) @db.Uuid
  partnerId              String       @map("partner_id") @db.Uuid
  amountMinor            Int          @map("amount_minor")
  currency               String       @db.VarChar(3)
  status                 PayoutStatus @default(REQUESTED)
  idempotencyKey         String       @map("idempotency_key") @db.VarChar(100)
  requestFingerprint     String       @map("request_fingerprint") @db.Char(64)
  destinationSnapshot    Json?        @map("destination_snapshot") @db.JsonB
  requestedByUserId      String       @map("requested_by_user_id") @db.Uuid
  processedByAdminUserId String?      @map("processed_by_admin_user_id") @db.Uuid
  externalReference      String?      @map("external_reference") @db.VarChar(200)
  requestedAt            DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  processedAt            DateTime?    @map("processed_at") @db.Timestamptz(6)
  note                   String?
  partner                Partner      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  requestedBy            User         @relation("PayoutRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  processedBy            User?        @relation("PayoutProcessedBy", fields: [processedByAdminUserId], references: [id], onDelete: Restrict)
  ledgerEntries          LedgerEntry[]

  @@unique([id, partnerId])
  @@unique([partnerId, idempotencyKey])
  @@index([status, requestedAt])
  @@index([partnerId, requestedAt])
  @@map("payouts")
}

model LedgerEntry {
  id                 String          @id @default(uuid()) @db.Uuid
  partnerId          String          @map("partner_id") @db.Uuid
  commissionId       String?         @map("commission_id") @db.Uuid
  payoutId           String?         @map("payout_id") @db.Uuid
  bucket             LedgerBucket
  amountMinor        Int             @map("amount_minor")
  entryType          LedgerEntryType @map("entry_type")
  transactionGroupId String          @map("transaction_group_id") @db.Uuid
  idempotencyKey     String          @unique @map("idempotency_key") @db.VarChar(200)
  metadata           Json?           @db.JsonB
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  partner            Partner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  commission         Commission?     @relation(fields: [commissionId, partnerId], references: [id, partnerId], onDelete: Restrict, onUpdate: Restrict)
  payout             Payout?         @relation(fields: [payoutId, partnerId], references: [id, partnerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([partnerId, bucket, createdAt])
  @@index([commissionId, createdAt])
  @@index([payoutId, createdAt])
  @@index([transactionGroupId])
  @@map("ledger_entries")
}

// S13/T31 workflow foundation. Completion/reversals belong to T32.
model Return {
  id                   String       @id @default(uuid()) @db.Uuid
  orderId              String       @map("order_id") @db.Uuid
  status               ReturnStatus @default(OPEN)
  reason               String
  createdByAdminUserId String       @map("created_by_admin_user_id") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  note                 String?
  order                Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy            User         @relation(fields: [createdByAdminUserId], references: [id], onDelete: Restrict)
  items                ReturnItem[]

  @@unique([id, orderId])
  @@index([orderId, status])
  @@index([status, createdAt, id])
  @@map("returns")
}

model ReturnItem {
  id          String    @id @default(uuid()) @db.Uuid
  returnId    String    @map("return_id") @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  quantity    Int
  return      Return    @relation(fields: [returnId, orderId], references: [id, orderId], onDelete: Restrict)
  orderItem   OrderItem @relation(fields: [orderItemId, orderId], references: [id, orderId], onDelete: Restrict)

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}
