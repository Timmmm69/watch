generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  telegramUserId   BigInt    @unique @map("telegram_user_id")
  firstName        String    @map("first_name") @db.VarChar(128)
  lastName         String?   @map("last_name") @db.VarChar(128)
  username         String?   @db.VarChar(64)
  languageCode     String?   @map("language_code") @db.VarChar(16)
  isAdmin          Boolean   @default(false) @map("is_admin")
  isBlocked        Boolean   @default(false) @map("is_blocked")
  botCanMessage    Boolean   @default(false) @map("bot_can_message")
  botStartedAt     DateTime? @map("bot_started_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  sessions         Session[]
  partner          Partner?
  auditLogs        AuditLog[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

enum TelegramUpdateStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model TelegramUpdate {
  updateId            BigInt               @id @map("update_id")
  payload             Json                 @db.JsonB
  status              TelegramUpdateStatus @default(PENDING)
  attempts            Int                  @default(0)
  nextAttemptAt       DateTime             @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  processingStartedAt DateTime?            @map("processing_started_at") @db.Timestamptz(6)
  leaseExpiresAt      DateTime?            @map("lease_expires_at") @db.Timestamptz(6)
  receivedAt          DateTime             @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt         DateTime?            @map("processed_at") @db.Timestamptz(6)
  lastError           String?              @map("last_error")

  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@index([receivedAt])
  @@map("telegram_updates")
}

enum LegalDocumentType {
  PARTNER_TERMS
  SALES_TERMS
  PRIVACY
}

model LegalDocument {
  id                   String            @id @default(uuid()) @db.Uuid
  type                 LegalDocumentType
  version              String            @db.VarChar(64)
  sha256               String            @db.Char(64)
  contentMarkdown      String            @map("content_markdown")
  requiresReacceptance Boolean           @default(false) @map("requires_reacceptance")
  effectiveAt          DateTime          @map("effective_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptances          PartnerTermsAcceptance[]

  @@unique([type, version])
  @@unique([type, sha256])
  @@map("legal_documents")
}

enum PartnerStatus {
  ACTIVE
  BLOCKED
}

model Partner {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @unique @map("user_id") @db.Uuid
  status      PartnerStatus @default(ACTIVE)
  blockReason String?       @map("block_reason")
  blockedAt   DateTime?     @map("blocked_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  acceptances PartnerTermsAcceptance[]

  @@index([status])
  @@map("partners")
}

model PartnerTermsAcceptance {
  partnerId       String        @map("partner_id") @db.Uuid
  legalDocumentId String        @map("legal_document_id") @db.Uuid
  acceptedAt      DateTime      @default(now()) @map("accepted_at") @db.Timestamptz(6)
  partner         Partner       @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  legalDocument   LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)

  @@id([partnerId, legalDocumentId])
  @@map("partner_terms_acceptances")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum VariantStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssetType {
  IMAGE
  VIDEO
  TEXT
}

enum AssetPurpose {
  STOREFRONT
  PARTNER_CONTENT
}

enum AssetStatus {
  ACTIVE
  ARCHIVED
}

enum InventorySourceStatus {
  UNINITIALIZED
  OK
  MISSING
  INVALID
}

model PlatformSetting {
  singletonId      Int      @id @default(1) @map("singleton_id") @db.SmallInt
  platformCurrency String   @unique @map("platform_currency") @db.VarChar(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

model Supplier {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @db.VarChar(200)
  status    SupplierStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@map("suppliers")
}

model Category {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @db.VarChar(120)
  slug      String         @unique @db.VarChar(140)
  sortOrder Int            @default(0) @map("sort_order")
  status    CategoryStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  products  ProductCategory[]

  @@index([status, sortOrder])
  @@map("categories")
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  supplierId     String          @map("supplier_id") @db.Uuid
  title          String          @db.VarChar(200)
  slug           String          @unique @db.VarChar(220)
  description    String          @default("")
  brand          String?         @db.VarChar(120)
  specifications Json            @default("{}") @db.JsonB
  status         ProductStatus   @default(DRAFT)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  variants       ProductVariant[]
  categories     ProductCategory[]
  assets         ProductAsset[]

  @@index([supplierId, status])
  @@index([status, brand])
  @@map("products")
}

model ProductVariant {
  id                           String          @id @default(uuid()) @db.Uuid
  productId                    String          @map("product_id") @db.Uuid
  sku                          String          @unique @db.VarChar(100)
  attributes                   Json            @default("{}") @db.JsonB
  priceMinor                   Int             @map("price_minor")
  currency                     String          @db.VarChar(3)
  partnerCommissionUnitMinor   Int             @map("partner_commission_unit_minor")
  supplierSettlementUnitMinor  Int?            @map("supplier_settlement_unit_minor")
  inventoryExternalKey         String          @unique @map("inventory_external_key") @db.VarChar(200)
  status                       VariantStatus   @default(DRAFT)
  createdAt                    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  product                      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryItem                InventoryItem?
  assets                       ProductAsset[]

  @@unique([id, productId])
  @@index([productId, status])
  @@map("product_variants")
}

model ProductCategory {
  productId String   @map("product_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
  @@map("product_categories")
}

model ProductAsset {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @map("product_id") @db.Uuid
  variantId   String?      @map("variant_id") @db.Uuid
  type        AssetType
  purpose     AssetPurpose
  storageKey  String?      @map("storage_key") @db.VarChar(500)
  textContent String?      @map("text_content")
  mimeType    String?      @map("mime_type") @db.VarChar(100)
  sizeBytes   Int?         @map("size_bytes")
  sortOrder   Int          @default(0) @map("sort_order")
  status      AssetStatus  @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Restrict)

  @@index([productId, purpose, status, sortOrder])
  @@map("product_assets")
}

model InventoryItem {
  variantId                String                @id @map("variant_id") @db.Uuid
  sourceQuantity           Int?                  @map("source_quantity")
  safetyBuffer             Int                   @default(0) @map("safety_buffer")
  sourceStatus             InventorySourceStatus @default(UNINITIALIZED) @map("source_status")
  sourceVersion            String?               @map("source_version") @db.VarChar(200)
  lastAttemptAt            DateTime?             @map("last_attempt_at") @db.Timestamptz(6)
  lastSuccessfulSyncAt     DateTime?             @map("last_successful_sync_at") @db.Timestamptz(6)
  lastSuccessfulSyncRunId  String?               @map("last_successful_sync_run_id") @db.Uuid
  updatedAt                DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  variant                  ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@map("inventory_items")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  requestId   String?  @map("request_id")
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@map("audit_logs")
}
