generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  telegramUserId   BigInt    @unique @map("telegram_user_id")
  firstName        String    @map("first_name") @db.VarChar(128)
  lastName         String?   @map("last_name") @db.VarChar(128)
  username         String?   @db.VarChar(64)
  languageCode     String?   @map("language_code") @db.VarChar(16)
  isAdmin          Boolean   @default(false) @map("is_admin")
  isBlocked        Boolean   @default(false) @map("is_blocked")
  botCanMessage    Boolean   @default(false) @map("bot_can_message")
  botStartedAt     DateTime? @map("bot_started_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  sessions         Session[]
  partner          Partner?
  auditLogs        AuditLog[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

enum TelegramUpdateStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model TelegramUpdate {
  updateId            BigInt               @id @map("update_id")
  payload             Json                 @db.JsonB
  status              TelegramUpdateStatus @default(PENDING)
  attempts            Int                  @default(0)
  nextAttemptAt       DateTime             @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  processingStartedAt DateTime?            @map("processing_started_at") @db.Timestamptz(6)
  leaseExpiresAt      DateTime?            @map("lease_expires_at") @db.Timestamptz(6)
  receivedAt          DateTime             @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt         DateTime?            @map("processed_at") @db.Timestamptz(6)
  lastError           String?              @map("last_error")

  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@index([receivedAt])
  @@map("telegram_updates")
}

enum LegalDocumentType {
  PARTNER_TERMS
  SALES_TERMS
  PRIVACY
}

model LegalDocument {
  id                   String            @id @default(uuid()) @db.Uuid
  type                 LegalDocumentType
  version              String            @db.VarChar(64)
  sha256               String            @db.Char(64)
  contentMarkdown      String            @map("content_markdown")
  requiresReacceptance Boolean           @default(false) @map("requires_reacceptance")
  effectiveAt          DateTime          @map("effective_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptances          PartnerTermsAcceptance[]

  @@unique([type, version])
  @@unique([type, sha256])
  @@map("legal_documents")
}

enum PartnerStatus {
  ACTIVE
  BLOCKED
}

model Partner {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @unique @map("user_id") @db.Uuid
  status      PartnerStatus @default(ACTIVE)
  blockReason String?       @map("block_reason")
  blockedAt   DateTime?     @map("blocked_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  acceptances PartnerTermsAcceptance[]

  @@index([status])
  @@map("partners")
}

model PartnerTermsAcceptance {
  partnerId       String        @map("partner_id") @db.Uuid
  legalDocumentId String        @map("legal_document_id") @db.Uuid
  acceptedAt      DateTime      @default(now()) @map("accepted_at") @db.Timestamptz(6)
  partner         Partner       @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  legalDocument   LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)

  @@id([partnerId, legalDocumentId])
  @@map("partner_terms_acceptances")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  requestId   String?  @map("request_id")
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@map("audit_logs")
}
