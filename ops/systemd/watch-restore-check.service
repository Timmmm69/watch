[Unit]
Description=Watch isolated backup restore verification
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=watch-deploy
WorkingDirectory=/opt/watch
EnvironmentFile=/etc/watch/backup.env
ExecStart=/usr/bin/node /opt/watch/ops/scripts/backup.mjs verify-latest
UMask=0077
TimeoutStartSec=2h
