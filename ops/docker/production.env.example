# Non-secret deployment config only. Copy to production.env (ignored).
# These placeholders are not production approval or real U07/U08 inputs.
RELEASE_TAG=replace-with-commit-sha
APP_BASE_URL=https://replace-with-real-domain.invalid
TELEGRAM_BOT_USERNAME=replace_with_bot_username
SUPPORT_CONTACT=replace-with-reviewed-support-contact
ADMIN_TELEGRAM_IDS=
# Set to 1 to admit all verified Telegram buyers, including in the owner-operated profile.
# This never grants admin rights or disables per-user blocks.
WATCH_PUBLIC_SHOP=
PLATFORM_CURRENCY=BYN
BUSINESS_TIMEZONE=Europe/Minsk
MIN_PAYOUT_MINOR=5000
ORDER_HOLD_DAYS=14
ORDER_OVERDUE_SECONDS=replace-with-accepted-sla-seconds
WATCH_PRODUCTION_APPROVAL_PATH=/replace-with-reviewed/production-approval.json
INVENTORY_PROVIDER=native
# Google is an optional one-shot import source, never a native runtime dependency.
# Cloudflare R2 (region auto) or Beget https://s3.ru1.storage.beget.cloud (region ru1).
OBJECT_STORAGE_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=replace-with-private-media-bucket
LEGAL_PARTNER_TERMS_ID=replace-with-production-uuid
LEGAL_PARTNER_TERMS_VERSION=replace-with-production-version
LEGAL_SALES_TERMS_ID=replace-with-production-uuid
LEGAL_SALES_TERMS_VERSION=replace-with-production-version
LEGAL_PRIVACY_ID=replace-with-production-uuid
LEGAL_PRIVACY_VERSION=replace-with-production-version
TELEGRAM_UPDATE_RETENTION_DAYS=30
# A reviewed manifest + markdown files mounted read-only for the bootstrap job.
WATCH_BOOTSTRAP_DIR=../bootstrap
