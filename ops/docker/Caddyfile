{
	admin off
	servers {
		protocols h1 h2
	}
}

{$APP_BASE_URL} {
	request_body {
		max_size 57671680
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org https://t.me"
		-Server
		-X-Powered-By
	}
	@api path /api/* /health /ready
	handle @api {
		reverse_proxy api:3001 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up -Forwarded
		}
	}
	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up -Forwarded
		}
	}
}
